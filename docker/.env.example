# Copiez ce fichier en `docker/.env` (il est ignoré par git), puis lancez
# depuis la racine du dépôt :
#
#   docker compose -f docker/docker-compose.service.yml up -d
#
# Docker Compose lit automatiquement docker/.env pour les variables ci-dessous.

# Répertoire hôte des données : entrées audio téléchargées et état des jobs.
# Doit exister et être accessible en écriture par CURRENT_UID/CURRENT_GID.
DATA_PATH=./data

# Répertoire hôte du cache HuggingFace, où sont téléchargés les poids Whisper.
# Évite de retélécharger plusieurs gigaoctets à chaque recréation de conteneur.
MODELS_PATH=./models

# UID et GID de l'utilisateur hôte, appliqués via le champ `user:` du service.
# Sans cela, le conteneur écrit en root et les fichiers deviennent inaccessibles
# à l'utilisateur sur la machine hôte.
#   Linux / macOS : `id -u` et `id -g`
#   Windows (PowerShell) :
#     [int[]][System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value
CURRENT_UID=1000
CURRENT_GID=1000

# Taille maximale d'un fichier audio en octets (500 Mio par défaut).
MAX_INPUT_SIZE=524288000

# Valeurs par défaut de MODEL et LANGUAGE.
#
# ATTENTION : l'application ne lit ni MODEL ni LANGUAGE. Le modèle et la langue
# se choisissent par requête (champs `model` et `language`, défauts `small` et
# `auto`). Ces deux variables sont conservées ici telles quelles, mais elles
# n'ont aucun effet sur le comportement du service.
MODEL=small
LANGUAGE=fr
